<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Hollandse Faseruimte Implosie (3D Piramide)</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #0d1117; font-family: 'Courier New', monospace; }
        #info {
            position: absolute; top: 20px; left: 20px; color: #c9d1d9;
            background: rgba(22, 27, 34, 0.8); padding: 15px;
            border: 1px solid #30363d; border-radius: 8px; pointer-events: none;
        }
        h2 { color: #58a6ff; margin-top: 0; }
        .highlight { color: #ff7b72; font-weight: bold; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>

    <div id="info">
        <h2>Traject: {54.240.4.2}</h2>
        <p>1. <span class="highlight">Haarlem (54)</span> - Trede 11</p>
        <p>2. <span class="highlight">Amstelveen (48)</span> - Trede 10</p>
        <p>3. <span class="highlight">Delft (4)</span> - Trede 1 (De Val)</p>
        <p>4. <span class="highlight">Dordrecht (2)</span> - Trede 0 (Nulpunt)</p>
        <p style="font-size: 0.8em; color: #8b949e; margin-top: 20px;">* Sleep met de muis om te roteren<br>* Scroll om te zoomen</p>
    </div>

    <script>
        // 1. Scene Setup
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(150, 100, 150);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.target.set(0, 30, 0);
        controls.update();

        // Verlichting
        scene.add(new THREE.AmbientLight(0x404040, 2));
        const dirLight = new THREE.DirectionalLight(0xffffff, 1);
        dirLight.position.set(50, 100, 50);
        scene.add(dirLight);

        // 2. Piramide Parameters
        const stappen = 13;
        const basis_breedte = 100;
        const stap_hoogte = 5;
        const stap_krimp = basis_breedte / (2 * stappen);

        const pyramidGroup = new THREE.Group();
        const matPyramid = new THREE.MeshStandardMaterial({ 
            color: 0x21262d, transparent: true, opacity: 0.7, wireframe: false 
        });
        const edgeMaterial = new THREE.LineBasicMaterial({ color: 0x30363d });

        // Bouw de 13 treden
        for (let i = 0; i < stappen; i++) {
            let breedte = basis_breedte - (2 * i * stap_krimp);
            let geo = new THREE.BoxGeometry(breedte, stap_hoogte, breedte);
            let mesh = new THREE.Mesh(geo, matPyramid);
            mesh.position.y = (i * stap_hoogte) + (stap_hoogte / 2);
            pyramidGroup.add(mesh);

            // Randen toevoegen voor zichtbaarheid
            let edges = new THREE.EdgesGeometry(geo);
            let line = new THREE.LineSegments(edges, edgeMaterial);
            line.position.y = mesh.position.y;
            pyramidGroup.add(line);
        }
        scene.add(pyramidGroup);

        // 3. Steden en Coördinaten (X, Hoogte/Y, Z_diepte)
        // Let op: Three.js gebruikt Y als hoogte-as in plaats van Z in OpenSCAD
        const posities = {
            haarlem:    new THREE.Vector3(-20, 11 * stap_hoogte + stap_hoogte, -30),
            amstelveen: new THREE.Vector3( 10, 10 * stap_hoogte + stap_hoogte, -25),
            delft:      new THREE.Vector3(-15,  1 * stap_hoogte + stap_hoogte,  15),
            dordrecht:  new THREE.Vector3(  5,  0 * stap_hoogte + stap_hoogte,  35)
        };

        // Knooppunten tekenen
        const nodeMat = new THREE.MeshStandardMaterial({ color: 0xff7b72 });
        const nodeGeo = new THREE.SphereGeometry(2.5, 32, 32);

        Object.values(posities).forEach(pos => {
            let node = new THREE.Mesh(nodeGeo, nodeMat);
            node.position.copy(pos);
            scene.add(node);
        });

        // 4. Verbindingslijnen (De Bliksemschicht)
        const lineMat = new THREE.LineBasicMaterial({ color: 0x58a6ff, linewidth: 3 });
        const points = [
            posities.haarlem,
            posities.amstelveen,
            posities.delft,
            posities.dordrecht
        ];
        const lineGeo = new THREE.BufferGeometry().setFromPoints(points);
        const traject = new THREE.Line(lineGeo, lineMat);
        scene.add(traject);

        // 5. Animatie Loop
        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }
        animate();

        // Responsive schalen
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
